# 智谱AI API Key（必需）
ZAI_API_KEY=your_zhipuai_api_key_here
# 模型与端点（可选）
# 若购买了「GLM Coding Plan」订阅，必须使用 coding 专属端点 + 计划覆盖的模型，
# 否则请求会走账户余额而非订阅配额（导致「余额不足」）。
ZAI_MODEL=glm-4.6
ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# ───────────────────────────────────────────────
# 方式一（推荐）：Google 生态 — Gmail API + Google Calendar API
# 在 Google Cloud Console 创建 OAuth 桌面客户端，下载 credentials.json 放到项目根目录，
# 然后运行：uv run mail-agent auth  完成一次浏览器授权。
# ───────────────────────────────────────────────
# 设为 true 才启用真实 Gmail/Calendar（默认 false，仅本地/演示，绝不触碰真实账户）
GOOGLE_ENABLED=false
# OAuth 客户端凭据路径（默认 ./credentials.json，从 Google Cloud 下载的完整 JSON）
GOOGLE_CREDENTIALS=credentials.json
# 备选：不放 credentials.json，直接填 client_id + client_secret（二选一）
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
# 授权 token 缓存路径（默认 ./data/token.json，自动生成）
GOOGLE_TOKEN=data/token.json
# 目标日历，primary 为主日历
GOOGLE_CALENDAR_ID=primary

# ───────────────────────────────────────────────
# 方式二：IMAP（仅读邮件，不创建 Google Calendar 日程）
# 需在 Gmail 开启两步验证并生成「应用专用密码」
# 启用此方式请将 GOOGLE_ENABLED 设为 false
# ───────────────────────────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=your_email@gmail.com
IMAP_PASSWORD=your_app_password

# 用户信息（用于生成个性化回复）
USER_NAME=Your Name
USER_EMAIL=your_email@example.com
